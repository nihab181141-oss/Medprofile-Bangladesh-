{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/projects",
      "destination": "/index.html"
    },
    {
      "source": "/projects.html",
      "destination": "/index.html"
    },
    {
      "source": "/our-projects",
      "destination": "/index.html"
    },
    {
      "source": "/our-projects.html",
      "destination": "/index.html"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
